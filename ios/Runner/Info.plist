<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AllGo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>in.allgo.customer</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>customer_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AllGo requires location to detect delivery address and accurate courier dispatch.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>AllGo requires continuous location during active deliveries and rides to calculate arrival ETA and route safety.</string>
	<key>NSCameraUsageDescription</key>
	<string>AllGo requires camera access to scan parcel delivery QR codes and set your profile photo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AllGo requires photo library access to choose a profile avatar and upload delivery receipts.</string>
	<!-- Google Maps API Key for iOS restricted by iOS Bundle Identifier in.allgo.customer -->
	<key>GoogleMapsApiKey</key>
	<string>$(GOOGLE_MAPS_CLIENT_IOS_KEY)</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

